.custom-nav .weatherBox.data-v-97323f43 {
  width: 90rpx;
  height: 90rpx;
}
.custom-nav .weatherBox .weatherImg.data-v-97323f43 {
  width: 100%;
  height: 100%;
}
.content.data-v-97323f43 {
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}
.diet-overview.data-v-97323f43 {
  margin-bottom: 30rpx;
}
.diet-overview .overview-title.data-v-97323f43 {
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.diet-overview .calories-card.data-v-97323f43 {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}
.diet-overview .calories-card .calories-info.data-v-97323f43 {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.diet-overview .calories-card .calories-info .calories-number.data-v-97323f43 {
  font-size: 60rpx;
  font-weight: bold;
  color: #4CAF50;
}
.diet-overview .calories-card .calories-info .calories-unit.data-v-97323f43 {
  font-size: 24rpx;
  color: #666;
  margin-left: 10rpx;
}
.diet-overview .calories-card .calories-progress .progress-bar.data-v-97323f43 {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}
.diet-overview .calories-card .calories-progress .progress-bar .progress-fill.data-v-97323f43 {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #8BC34A);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}
.diet-overview .calories-card .calories-progress .progress-text.data-v-97323f43 {
  font-size: 24rpx;
  color: #666;
}
.quick-record.data-v-97323f43 {
  margin-bottom: 30rpx;
}
.quick-record .section-title.data-v-97323f43 {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.quick-record .record-buttons.data-v-97323f43 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.quick-record .record-buttons .record-btn.data-v-97323f43 {
  background: white;
  border: none;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s ease;
}
.quick-record .record-buttons .record-btn.data-v-97323f43:active {
  transform: scale(0.95);
}
.quick-record .record-buttons .record-btn .btn-icon.data-v-97323f43 {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}
.quick-record .record-buttons .record-btn .btn-text.data-v-97323f43 {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.today-records .section-title.data-v-97323f43 {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.today-records .meal-list.data-v-97323f43 {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}
