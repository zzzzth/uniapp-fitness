<view class="custom-nav data-v-97323f43"><common-nav-bar class="data-v-97323f43" u-s="{{['weather','text']}}" u-i="97323f43-0" bind:__l="__l"><view class="weatherBox data-v-97323f43" slot="weather"><image class="weatherImg data-v-97323f43" src="{{a}}" mode="aspectFill"></image></view><view class="text data-v-97323f43" slot="text">健康饮食，从今天开始!</view></common-nav-bar></view><view class="content data-v-97323f43"><view class="diet-overview data-v-97323f43"><view class="overview-title data-v-97323f43">今日饮食</view><view class="calories-card data-v-97323f43"><view class="calories-info data-v-97323f43"><text class="calories-number data-v-97323f43">{{b}}</text><text class="calories-unit data-v-97323f43">kcal</text></view><view class="calories-progress data-v-97323f43"><view class="progress-bar data-v-97323f43"><view class="progress-fill data-v-97323f43" style="{{'width:' + c}}"></view></view><text class="progress-text data-v-97323f43">目标: {{d}} kcal</text></view></view></view><view class="quick-record data-v-97323f43"><view class="section-title data-v-97323f43">快速记录</view><view class="record-buttons data-v-97323f43"><button class="record-btn breakfast data-v-97323f43" bindtap="{{e}}"><text class="btn-icon data-v-97323f43">🌅</text><text class="btn-text data-v-97323f43">早餐</text></button><button class="record-btn lunch data-v-97323f43" bindtap="{{f}}"><text class="btn-icon data-v-97323f43">☀️</text><text class="btn-text data-v-97323f43">午餐</text></button><button class="record-btn dinner data-v-97323f43" bindtap="{{g}}"><text class="btn-icon data-v-97323f43">🌙</text><text class="btn-text data-v-97323f43">晚餐</text></button><button class="record-btn snack data-v-97323f43" bindtap="{{h}}"><text class="btn-icon data-v-97323f43">🍎</text><text class="btn-text data-v-97323f43">加餐</text></button></view></view><view class="today-records data-v-97323f43"><view class="section-title data-v-97323f43">今日记录</view><view class="meal-list data-v-97323f43"><view tt:for="{{i}}" tt:for-item="meal" tt:key="d" class="meal-item data-v-97323f43"><view class="meal-info data-v-97323f43"><text class="meal-name data-v-97323f43">{{meal.a}}</text><text class="meal-calories data-v-97323f43">{{meal.b}} kcal</text></view><view class="meal-time data-v-97323f43">{{meal.c}}</view></view></view></view></view>