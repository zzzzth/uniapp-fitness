.custom-nav .weatherBox.data-v-fc23ec97 {
  width: 90rpx;
  height: 90rpx;
}
.custom-nav .weatherBox .weatherImg.data-v-fc23ec97 {
  width: 100%;
  height: 100%;
}
.content.data-v-fc23ec97 {
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}
.week-overview.data-v-fc23ec97 {
  margin-bottom: 30rpx;
}
.week-overview .overview-title.data-v-fc23ec97 {
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.week-overview .stats-grid.data-v-fc23ec97 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.week-overview .stats-grid .stat-card.data-v-fc23ec97 {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}
.week-overview .stats-grid .stat-card .stat-number.data-v-fc23ec97 {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #4CAF50;
  margin-bottom: 10rpx;
}
.week-overview .stats-grid .stat-card .stat-label.data-v-fc23ec97 {
