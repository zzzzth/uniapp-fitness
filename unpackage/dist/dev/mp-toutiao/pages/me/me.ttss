.custom-nav .weatherBox.data-v-19c123a7 {
  width: 90rpx;
  height: 90rpx;
}
.custom-nav .weatherBox .weatherImg.data-v-19c123a7 {
  width: 100%;
  height: 100%;
}
.content.data-v-19c123a7 {
  padding: 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
}
.user-info.data-v-19c123a7 {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}
.user-info .avatar.data-v-19c123a7 {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  margin-right: 30rpx;
}
.user-info .avatar image.data-v-19c123a7 {
  width: 100%;
  height: 100%;
}
.user-info .user-details.data-v-19c123a7 {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.user-info .user-details .username.data-v-19c123a7 {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}
.user-info .user-details .user-level.data-v-19c123a7 {
  font-size: 24rpx;
  color: #4CAF50;
}
.user-info .edit-btn.data-v-19c123a7 {
  padding: 15rpx 30rpx;
  background: #f0f0f0;
  border-radius: 20rpx;
}
.user-info .edit-btn text.data-v-19c123a7 {
  font-size: 24rpx;
  color: #666;
}
.data-overview.data-v-19c123a7 {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}
.data-overview .data-item.data-v-19c123a7 {
  text-align: center;
}
.data-overview .data-item .data-number.data-v-19c123a7 {
  display: block;
