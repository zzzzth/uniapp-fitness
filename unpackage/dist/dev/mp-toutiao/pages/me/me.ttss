}
.menu-section.data-v-19c123a7 {
  background: white;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}
.menu-section .menu-item.data-v-19c123a7 {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.menu-section .menu-item.data-v-19c123a7:last-child {
  border-bottom: none;
}
.menu-section .menu-item.data-v-19c123a7:active {
  background: #f8f8f8;
}
.menu-section .menu-item .menu-icon.data-v-19c123a7 {
