}
.today-records .meal-list .meal-item .meal-info.data-v-97323f43 {
  display: flex;
  flex-direction: column;
}
.today-records .meal-list .meal-item .meal-info .meal-name.data-v-97323f43 {
  font-size: 32rpx;
