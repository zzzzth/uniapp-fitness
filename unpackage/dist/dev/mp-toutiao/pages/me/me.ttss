}
.menu-section .menu-item .menu-text.data-v-19c123a7 {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}
.menu-section .menu-item .menu-arrow.data-v-19c123a7 {
  font-size: 32rpx;
  color: #ccc;
}
